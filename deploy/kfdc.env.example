# kfdc service configuration — install to ~/.config/kfdc/kfdc.env on the
# host that serves the board. This file is NOT part of the published bundle
# in any meaningful sense: the bundle carries this template, the real one is
# host state that survives every deploy untouched.
#
# The clone's own .env is a different thing: it configures `npm run dev` and
# the curator on kai. Do not point the service at it — a clone-less host is
# the whole point of deploying from the store.

# korg production API (tailnet). Server-only; never reaches the client.
KORG_URL=https://kubsdb.encke-wahoo.ts.net:5674
#KORG_TOKEN=

# Placement. Both are required — install.sh refuses to activate without
# them rather than let the adapter default to :3000 with a wrong origin.
# PORT must match the `tailscale serve` entry declared for this host in
# k-homelab manifests/<host>.yml.
PORT=8100
ORIGIN=https://kai.encke-wahoo.ts.net:8100
