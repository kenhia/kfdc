# Development and publishing config for this checkout. The *service* is
# configured elsewhere — ~/.config/kfdc/kfdc.env on the host that serves the
# board (template: deploy/kfdc.env.example) — because a host that deploys
# from the store has no checkout to read.

# korg production API (tailnet). No auth today; KORG_TOKEN is the single
# place a bearer token would go if that ever changes — server-only, never
# shipped to the client. Used by `npm run dev` and by the curator.
KORG_URL=https://kubsdb.encke-wahoo.ts.net:5674
#KORG_TOKEN=

# Homelab package store (k-homelab docs/deploying.md). Neither has a
# default: a guessed hostname fails as a confusing curl error instead of a
# sentence. URL is what installers fetch from; HOST is where kpkg runs, and
# is only needed to publish.
KFDC_STORE_URL=https://kubsdb.encke-wahoo.ts.net:4880
KFDC_STORE_HOST=kubsdb

# The host that serves the board. Since sprint 009 this is NOT the host
# holding this checkout: the clone (and the curator) stay on kai, the board
# runs on kubsdb. `just deploy` and `just versions` act on this host, over
# ssh when it is not this machine. No default, for the same reason as the
# store variables — a guessed host installs the board somewhere nobody is
# looking and reports success.
KFDC_DEPLOY_HOST=kubsdb
